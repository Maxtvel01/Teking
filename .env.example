# База данных
DATABASE_URL=sqlite:///./teking.db

# === ИИ-консультант ===
# Kimi (Moonshot AI) — OpenAI-compatible API, работает из РФ.
# Получить ключ: https://platform.kimi.ai (регистрация, мин. пополнение $1)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.moonshot.ai/v1
# kimi-k2.6 — $0.95 вход / $4.00 выход за 1M токенов (рекомендуется)
# kimi-k3    — флагман $3.00 / $15.00 за 1M (избыточен для чата)
LLM_MODEL=kimi-k2.6

# Дешёвая альтернатива — DeepSeek: https://platform.deepseek.com (ключ после регистрации, пополнение от $1)
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# Цены deepseek-chat: ~$0.27 вход / $1.10 выход за 1M токенов.

# Альтернативы, если нужен российский провайдер (замените URL/модель):
# GigaChat (Сбер):    LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1, LLM_MODEL=GigaChat-2
# YandexGPT:          LLM_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1, LLM_MODEL=yandexgpt-lite

HUMAN_SUPPORT_LINK=#support
ADMIN_PASSWORD=admin
APP_HOST=0.0.0.0
APP_PORT=8000
